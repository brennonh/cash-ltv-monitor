# ─── RPC ───────────────────────────────────────────────
SCROLL_RPC_URL=https://rpc.scroll.io

# ─── Contract Addresses (Scroll mainnet, chain 534352) ─
CASH_LENS_ADDRESS=0x0000000000000000000000000000000000000000
DEBT_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
SAFE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Polling ───────────────────────────────────────────
POLL_INTERVAL_MS=30000
POLL_BATCH_SIZE=50
# Block from which to start indexing SafeCreated events
INDEX_FROM_BLOCK=0

# ─── Risk Thresholds ───────────────────────────────────
HF_WARNING_THRESHOLD=1.3
HF_CRITICAL_THRESHOLD=1.1
HF_LIQUIDATABLE_THRESHOLD=1.0

# ─── Alerting ──────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERT_COOLDOWN_MS=3600000

# ─── Database ──────────────────────────────────────────
# SQLite file path (relative to project root)
DB_PATH=./data/ltv_monitor.sqlite

# ─── API ───────────────────────────────────────────────
PORT=3000
