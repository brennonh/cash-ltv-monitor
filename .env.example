# ═══════════════════════════════════════════════════════════════════
#  cash-ltv-monitor — sample .env
#
#  Contract addresses are identical across all supported chains.
#  Source: deployments/mainnet/<chainId>/deployments.json in cash-v3 repo
#  Repo: https://github.com/etherfi-protocol/cash-v3
# ═══════════════════════════════════════════════════════════════════

# ─── RPC ────────────────────────────────────────────────────────────
# Chain RPC endpoint. Examples:
#   Optimism:  https://mainnet.optimism.io
#   Scroll:    https://rpc.scroll.io
#   Base:      https://mainnet.base.org
# For production use a dedicated node: Alchemy, Infura, or QuickNode
RPC_URL=https://mainnet.optimism.io

# ─── Contract Addresses (same across all supported chains) ──────────
CASH_LENS_ADDRESS=0x7DA874f3BacA1A8F0af27E5ceE1b8C66A772F84E
DEBT_MANAGER_ADDRESS=0x0078C5a459132e279056B2371fE8A8eC973A9553
SAFE_FACTORY_ADDRESS=0xF4e147Db314947fC1275a8CbB6Cde48c510cd8CF

# ─── Indexing ───────────────────────────────────────────────────────
# Block to start replaying BeaconProxyDeployed events from.
# Set to the factory deployment block on your chain to avoid scanning from 0.
# Leave as 0 to scan all history (slow on first run).
INDEX_FROM_BLOCK=0

# ─── Polling ────────────────────────────────────────────────────────
# How often to poll all safes (milliseconds). 30s is a sensible default.
POLL_INTERVAL_MS=30000
# How many safes to batch into one multicall. 50 is safe for public RPC.
# Raise to 100–200 if using a dedicated node.
POLL_BATCH_SIZE=50

# ─── Risk Thresholds ────────────────────────────────────────────────
# Health Factor at or below which each tier triggers.
# Health Factor = maxBorrowCapacity / totalBorrowed
HF_WARNING_THRESHOLD=1.3
HF_CRITICAL_THRESHOLD=1.1
HF_LIQUIDATABLE_THRESHOLD=1.0

# ─── Alerting ───────────────────────────────────────────────────────
# Slack Incoming Webhook URL. Leave blank to log alerts to stdout only.
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# How long to suppress repeat alerts for the same safe + tier (ms).
# Default: 1 hour
ALERT_COOLDOWN_MS=3600000

# ─── Database ───────────────────────────────────────────────────────
# SQLite file path, relative to the project root.
# The directory is created automatically on startup.
DB_PATH=./data/ltv_monitor.sqlite

# ─── API ────────────────────────────────────────────────────────────
PORT=3000
