# Tell pnpm to hoist packages needed by NestJS / TypeORM
# so they're resolvable at the root node_modules level
public-hoist-pattern[]=*nestjs*
public-hoist-pattern[]=*typeorm*
public-hoist-pattern[]=reflect-metadata

# Silence pnpm peer dependency warnings for known NestJS quirks
strict-peer-dependencies=false
auto-install-peers=true
